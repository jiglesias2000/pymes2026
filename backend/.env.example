JWT_SECRET=cambiar_por_un_secreto_seguro
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_seguro

# Base de datos: SQLite (default) o PostgreSQL (Supabase)
# Para usar SQLite: no definir estas variables o usar DB_DIALECT=sqlite
# Para usar Supabase PostgreSQL:
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
