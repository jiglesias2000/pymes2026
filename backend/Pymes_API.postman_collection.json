	"item": [
		{
			"name": "Seguridad",
			"item": [
				{
					"name": "Login (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Retorna accessToken y refreshToken', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.accessToken).to.be.a('string');",
									"    pm.expect(json.refreshToken).to.be.a('string');",
									"    pm.collectionVariables.set('accessToken', json.accessToken);",
									"    pm.collectionVariables.set('refreshToken', json.refreshToken);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Login - credenciales inválidas",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 con mensaje de error', () => {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.message).to.include('incorrecto');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"claveIncorrecta\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Retorna nuevo accessToken', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.accessToken).to.be.a('string');",
									"    pm.collectionVariables.set('accessToken', json.accessToken);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/refreshtoken",
							"host": ["{{baseUrl}}"],
							"path": ["api", "refreshtoken"]
						}
					}
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
